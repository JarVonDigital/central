{
  "name": "hub",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:jde": "ng build ui --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:site && npm run test:accessibility",
    "prebuild": "node scripts/configure-site.mjs",
    "test:site": "node scripts/test-site.mjs",
    "test:accessibility": "node scripts/test-accessibility.mjs"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/forms": "^20.3.34",
    "@angular/platform-browser": "^20.3.34",
    "@angular/router": "^20.3.34",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.40",
    "@angular/cli": "^20.3.40",
    "@angular/compiler-cli": "^20.3.34",
    "@axe-core/playwright": "^4.14.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.9",
    "ng-packagr": "^20.3.2",
    "playwright": "^1.62.1",
    "tsx": "^4.20.4",
    "typescript": "^5.8.3"
  }
}
